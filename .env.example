# Database connections (local non-secret defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map_test

# Public Amap browser key (https://console.amap.com). This is a PUBLIC key shipped to
# the browser and restricted by the Amap console to the app domain/referrers.
# Never put a server-side secret or private key here.
# NEXT_PUBLIC_AMAP_KEY=
