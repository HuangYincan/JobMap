# Database connections (local non-secret defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map_test

# AMap Web Service API configuration
# Get both keys from: https://console.amap.com/dev/key/app
# 1. NEXT_PUBLIC_AMAP_KEY: Your "Web端(JS API)" key (public, shipped to browser)
# 2. NEXT_PUBLIC_AMAP_SECURITY_CODE: Your "安全密钥" from the same application
# Both are required for AMap JS API 2.0 to work properly.
NEXT_PUBLIC_AMAP_KEY=your_web_js_api_key_here
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_security_jscode_here

# Optional. Web 服务 key for server-side geocode (npm run geocode:sites later).
# Never print this. Do not reuse the JS key here.
# AMAP_WEB_KEY=
