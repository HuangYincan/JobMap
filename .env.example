# ============================================================
# 环境变量模板 — 唯一生效的配置文件是 server/.env.local
# ============================================================
#
# 使用方法(在 server/ 目录下执行):
#   cp ../.env.example .env.local
# 然后填入下面的真实 key。git 已忽略 .env.local,不会误提交;
# 模板本身不含秘密,放心提交。
#
# 为什么模板在根目录?
#   Next.js 只从应用根目录(server/)自动加载 .env.local;
#   模板放根目录是部署脚本(tech/15-deploy.md)的约定路径。
#   注意:根目录不要放 .env.local——它不是配置文件,只会让人混淆。

# ---------- 数据库(本地默认值,非敏感) ----------
# 本地 PostGIS 连接。DB 读路径、seed 导入(npm run import:seed:apply)都依赖(必需)。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map
# 集成测试专用库(带 DATABASE_URL 跑测试套件时用)。
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map_test

# ---------- 高德地图 ----------
# 从 https://console.amap.com/dev/key/app 申请,同一个应用下取两个 key:
# 1. NEXT_PUBLIC_AMAP_KEY: 「Web端(JS API)」key —— 会下发到浏览器,公开无妨。
# 2. NEXT_PUBLIC_AMAP_SECURITY_CODE: 同一应用的「安全密钥」。
# 两者缺一,高德 JS API v2.0 无法初始化地图(必需)。
NEXT_PUBLIC_AMAP_KEY=your_web_js_api_key_here
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_security_jscode_here

# 3. AMAP_WEB_KEY: 「Web服务」key —— 服务端调高德 REST 用,
#    npm run geocode:sites:apply(公司落真实办公点)依赖它(必需)。
#    服务端秘密:永不打印、永不提交;不要复用上面的 JS key。
#    取消注释并填入真实 key:
# AMAP_WEB_KEY=

# ---------- LLM(可选,按需) ----------
# 岗位真实性校验脚本(server/scripts/validate-positions-llm.mjs)用,
# 与上面高德 key 一样从 server/.env.local 读取,key 绝不打印、不写报告。
# 三个一起配;不配不影响应用运行,仅脚本自动降级为 dry-run。
#   LLM_API_KEY:  必填,否则脚本 dry-run(不调用 LLM)。
#   LLM_MODEL:    必填,模型名(如 deepseek-chat / gpt-4o)。
#   LLM_BASE_URL: OpenAI 兼容端点,默认 https://api.openai.com/v1;
#                 用国内服务(DeepSeek/通义/硅基流动等)时填对应地址。
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
