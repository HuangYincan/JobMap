# ============================================================
# 环境变量模板 — 唯一生效的配置文件是 server/.env.local
# ============================================================
#
# 使用方法(在 server/ 目录下执行):
#   cp .env.example .env.local
# 然后填入下面的真实 key。git 已忽略 .env.local,不会误提交;
# 模板本身不含秘密,放心提交。
#
# 为什么模板在 server/ 目录?
#   Next.js 只从应用根目录(server/)自动加载 .env.local;
#   模板与它同目录,`cp .env.example .env.local` 即可,无需跨目录。
#   注意:根目录不要放 .env.local——它不是配置文件,只会让人混淆。

# ---------- 数据库(本地默认值,非敏感) ----------
# 本地 PostGIS 连接。DB 读路径、seed 导入(npm run import:seed:apply)都依赖(必需)。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map
# 集成测试专用库(带 DATABASE_URL 跑测试套件时用)。
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_map_test

# ---------- 高德地图 ----------
# 从 https://console.amap.com/dev/key/app 申请,同一个应用下取两个 key:
# 1. NEXT_PUBLIC_AMAP_KEY: 「Web端(JS API)」key —— 会下发到浏览器,公开无妨。
# 2. NEXT_PUBLIC_AMAP_SECURITY_CODE: 同一应用的「安全密钥」。
# 两者缺一,高德 JS API v2.0 无法初始化地图(必需)。
NEXT_PUBLIC_AMAP_KEY=your_web_js_api_key_here
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_security_jscode_here

# 3. AMAP_WEB_KEY: 「Web服务」key —— 服务端调高德 REST 用,
#    npm run geocode:sites:apply(公司落真实办公点)依赖它(必需)。
#    服务端秘密:永不打印、永不提交;不要复用上面的 JS key。
#    取消注释并填入真实 key:
# AMAP_WEB_KEY=

# 4. BAIDU_MAP_AK: 百度地图 Web 服务 key —— 高德日配额耗尽(infocode 10044)
#    或未配 AMAP_WEB_KEY 时的自动兜底(同样 GCJ-02 坐标,无需转换)。
#    申请:https://lbs.baidu.com/apiconsole/key
#    服务端秘密:永不打印、永不提交。
# BAIDU_MAP_AK=

# 5. TENCENT_MAP_KEY: 腾讯位置服务 WebService key —— 百度兜底也失败后的
#    第三级兜底(同样 GCJ-02 坐标,无需转换)。个人开发者每接口 10000 次/天、
#    5 QPS(官方 FAQ);注意需完成个人认证,未认证的配额很小
#    (2026-08-21 实测:当日约 7 次调用即耗尽,status 121)。
#    申请:https://lbs.qq.com 控制台创建 WebService key(IP 白名单可选,
#    若返回 status 110 请核对白名单)。
#    服务端秘密:永不打印、永不提交。
# TENCENT_MAP_KEY=

# ---------- 前端地图引擎 key(NEXT_PUBLIC_*,公开) ----------
# 腾讯/百度 JS API 前端渲染 key。与上面 AMAP_WEB_KEY / BAIDU_MAP_AK /
# TENCENT_MAP_KEY 三个**服务端** key 不同:NEXT_PUBLIC_* 会内联进浏览器构建
# 产物,是公开 key,只用于前端加载地图;生产切换 key 需重新构建部署。
# NEXT_PUBLIC_TENCENT_JSAPI_KEY: 申请 https://lbs.qq.com 控制台新建 key,
#   产品勾选「JS API GL」。
NEXT_PUBLIC_TENCENT_JSAPI_KEY=
# NEXT_PUBLIC_BAIDU_AK: 申请 https://lbs.baidu.com 控制台,**必须新建「浏览器端」类型的
#   AK**(与上面 BAIDU_MAP_AK 的「服务端」key 严格区分——百度按应用类型隔离,服务端 key
#   调 JSAPI 会被拒「APP服务被禁用了」);JSAPI 需配 referer 白名单(开发 localhost:3000,
#   生产真实域名)。
NEXT_PUBLIC_BAIDU_AK=

# ---------- LLM(可选,按需) ----------
# 岗位真实性校验脚本(server/scripts/validate-positions-llm.mjs)用,
# 与上面高德 key 一样从 server/.env.local 读取,key 绝不打印、不写报告。
# 三个一起配;不配不影响应用运行,仅脚本自动降级为 dry-run。
#   LLM_API_KEY:  必填,否则脚本 dry-run(不调用 LLM)。
#   LLM_MODEL:    必填,模型名(如 deepseek-chat / gpt-4o)。
#   LLM_BASE_URL: OpenAI 兼容端点,默认 https://api.openai.com/v1;
#                 用国内服务(DeepSeek/通义/硅基流动等)时填对应地址。
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# --- AI Agent (2026-08-21, tech/24-agent-feature) ---
# 可选:覆盖默认 LLM(默认回退 LLM_API_KEY/LLM_MODEL/LLM_BASE_URL)
# AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_API_KEY=sk-...
# AGENT_LLM_MODEL=deepseek-v4-flash
# AGENT_MAX_TOOL_TURNS=16
# AGENT_HISTORY_LIMIT=6000
# 百度 agentplan SK(未配置则 baidu-ai-map 工具组不注册;申请:https://lbs.baidu.com/apiconsole/agentplan)
# BAIDU_MAP_AUTH_TOKEN=sk-...

# ---------- 邮件(Resend) ----------
# 邮箱 OTP 验证码经 Resend 真发(tech/25);未配置时发送接口返回
# 503 EMAIL_NOT_CONFIGURED(phone 走下方阿里云短信,不依赖此 key)。
# 申请:https://resend.com 创建 API Key(免费额度约 3000 封/月)。
# 服务端秘密:永不打印、永不提交;取消注释并填入真实 key:
# RESEND_API_KEY=

# ---------- 短信(阿里云短信认证服务 dypnsapi) ----------
# 手机 OTP 验证码经阿里云短信认证服务(SendSmsVerifyCode)真发;
# 未配置时发送接口返回 503 SMS_NOT_CONFIGURED。
# 申请:https://help.aliyun.com/zh/pnvs(开通「短信认证」,控制台创建
# AccessKey 与短信签名/模板;模板参数 {"code": "...", "min": "N"} 直接传值,
# 赠送模板为 {code, min} 双变量,min 缺省会报 isv.INVALID_PARAMETERS)。
# 服务端秘密:永不打印、永不提交;取消注释并填入真实值:
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_TEMPLATE_MINUTES=5   # 可选,默认 5:模板 min 变量值(「X 分钟内有效」文案),须与模板变量匹配

# ---------- 第三方登录(OAuth,tech/27) ----------
# 真实 OAuth 2.0 authorization code flow(GitHub / Google / 微信)。
# 三个 provider 均可选:未配置时前端按钮自动回退 demo 登录(功能不坏)。
# 申请入口与操作步骤见 tech/27-oauth-login.md「⚠️ 手动配置清单」:
#   GitHub:  github.com → Settings → Developer settings → OAuth Apps
#   Google:  console.cloud.google.com → Credentials → OAuth client ID(Web application)
#   微信:    open.weixin.qq.com 网站应用(需已 ICP 备案域名,localhost 不可用)
# 三方后台注册的回调地址必须与
#   <站点origin>/api/auth/oauth/callback/<provider>
# 完全一致(开发 localhost:3000 可用;微信除外)。
# 服务端秘密:永不打印、永不提交;取消注释并填入真实 key:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# WECHAT_OAUTH_APP_ID=
# WECHAT_OAUTH_SECRET=
# (SESSION_SECRET 同时兼任 oauth_state 签名密钥:多实例部署建议显式设置,
#  未设置时 boot 随机。)

# ---------- 反向代理 / 限流 ----------
# 仅当 Next.js 确定部署在可信反向代理之后才配置。填代理的出站 IP,逗号分隔。
# 配置后 auth/agent 限流信任 X-Forwarded-For / X-Real-IP;反代必须覆盖或清洗
# 客户端自带的这两个头。不配置时服务端忽略转发头,匿名请求共享保守限流桶。
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2

# ---------- 阿里云短信认证服务(phone OTP 真发)----------
# 经 dypnsapi SendSmsVerifyCode 真实发送手机验证码;四条缺任一 → 发送接口
# 503 SMS_NOT_CONFIGURED(优雅降级,不影响 email/其他功能)。服务端秘密,
# 绝不提交/打印。开通步骤见 tech/26 §6:控制台开通「短信认证服务」→ 取
# 系统赠送签名 + 赠送模板 CODE(参数名 code)→ RAM AccessKey 授权
# dypns:SendSmsVerifyCode。
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
